{
  "name": "rubix-redux",
  "private": true,
  "version": "0.1.0",
  "description": "Data-driven landing page system on React, Vite and Decap CMS, hosted on Netlify.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-og-manifest.mjs",
    "build": "vite build",
    "postbuild": "node scripts/patch-admin-config.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/build-og-manifest.mjs && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.netlify.json",
    "lint": "eslint .",
    "pretest": "node scripts/build-og-manifest.mjs",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "setup": "node scripts/setup.mjs",
    "placeholders": "node scripts/make-placeholders.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@netlify/edge-functions": "^4.0.3",
    "@netlify/functions": "^6.0.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
